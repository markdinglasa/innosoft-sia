{
  "name": "innosoft-sia",
  "version": "1.1.4",
  "description": "Innosoft Sales Insights and Analytics",
  "main": "./out/main/index.js",
  "author": "Mark Dinglasa",
  "homepage": "https://github.com/markdinglasa/innosoft-electron-boilerplate",
  "license": "INNOSOFT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "dist": "electron-builder --publish always"
  },
  "build": {
    "appId": "com.innosoft.sia",
    "productName": "iSIA",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "markdinglasa",
        "repo": "https://github.com/markdinglasa/innosoft-sia"
      }
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mdi/js": "^7.0.96",
    "@mdi/react": "^1.6.1",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@reduxjs/toolkit": "^1.9.7",
    "auto-launch": "^5.0.6",
    "csv-writer": "^1.6.0",
    "date-fns": "^3.6.0",
    "electron-debug": "^3.2.0",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "formik": "^2.2.9",
    "html2pdf": "^0.0.11",
    "html2pdf.js": "^0.10.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "lodash-es": "^4.17.21",
    "mssql": "^11.0.0",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "polyfill": "^0.1.0",
    "react": "^18.2.0",
    "react-auth-kit": "^3.1.2",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.22.3",
    "react-toastify": "^9.0.7",
    "recharts": "^2.3.2",
    "styled-components": "^5.3.11",
    "tedious": "^18.2.1",
    "tweetnacl": "^1.0.3",
    "url": "^0.11.3",
    "util": "^0.12.5",
    "yup": "^0.32.11"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@electron-toolkit/eslint-config-ts": "^1.0.1",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "^1.2.3",
    "@electron/rebuild": "^3.2.10",
    "@types/auto-launch": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mssql": "^9.1.5",
    "@types/multer": "^1.4.12",
    "@types/node": "^18.19.9",
    "@types/react": "^18.2.48",
    "@types/react-copy-to-clipboard": "^5.0.4",
    "@types/react-dom": "^18.2.18",
    "@types/styled-components": "^5.1.34",
    "@types/yup": "^0.29.14",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^7.3.0",
    "core-js": "^3.24.1",
    "cross-env": "^7.0.3",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "file-loader": "^6.2.0",
    "prettier": "^3.2.4",
    "redux-devtools-extension": "^2.13.9",
    "style-loader": "^3.3.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "url-loader": "^4.1.1",
    "vite": "^5.0.12"
  }
}
