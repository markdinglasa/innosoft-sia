{
  "name": "innosoft-pos",
  "version": "2.0.0",
  "description": "Innosoft Point of Sale",
  "main": "./out/main/index.js",
  "author": "Mark Dinglasa",
  "homepage": "https://github.com/markdinglasa/innosoft-electron-boilerplate",
  "license": "INNOSOFT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "lint:security": "eslint src/memo --ext .ts --config .eslintrc.cjs --rule 'security/*:error'",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:memo": "tsc --noEmit -p tsconfig.memo.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:memo",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "build:memo": "tsc -p tsconfig.memo.json",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "dist": "electron-builder --publish always",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:memo": "vitest run src/memo/tests --reporter=verbose",
    "test:memo:pbt": "vitest run src/memo/tests --reporter=verbose --testNamePattern='property'",
    "test:memo:unit": "vitest run src/memo/tests --reporter=verbose --testNamePattern='^(?!.*property).*$'"
  },
  "build": {
    "appId": "com.innosoft.pos",
    "productName": "NUTSHELL",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "markdinglasa",
        "repo": "https://github.com/markdinglasa/innosoft-sia"
      }
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1009.0",
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.2.2",
    "@mdi/js": "^7.0.96",
    "@mdi/react": "^1.6.1",
    "@mui/icons-material": "^6.3.1",
    "@mui/material": "^6.3.1",
    "@nestjs/common": "^11.1.17",
    "@nestjs/core": "^11.1.17",
    "@nestjs/swagger": "^11.2.6",
    "@reduxjs/toolkit": "^1.9.7",
    "@tanstack/react-query": "^5.90.21",
    "@types/better-sqlite3": "^7.6.13",
    "auto-launch": "^5.0.6",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^12.8.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "clsx": "^2.1.1",
    "csv-writer": "^1.6.0",
    "date-fns": "^3.6.0",
    "echarts": "^6.0.0",
    "electron-debug": "^3.2.0",
    "electron-log": "^4.4.8",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "formik": "^2.2.9",
    "html2pdf": "^0.0.11",
    "html2pdf.js": "^0.14.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.3",
    "lodash-es": "^4.17.21",
    "mssql": "^11.0.0",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "polyfill": "^0.1.0",
    "react": "^18.2.0",
    "react-auth-kit": "^3.1.2",
    "react-copy-to-clipboard": "^5.1.0",
    "react-dom": "^18.2.0",
    "react-error-boundary": "^6.1.1",
    "react-hook-form": "^7.71.2",
    "react-icons": "^5.0.1",
    "react-redux": "^8.0.2",
    "react-router-dom": "^6.22.3",
    "react-toastify": "^9.0.7",
    "recharts": "^2.3.2",
    "reflect-metadata": "^0.2.1",
    "resend": "^6.9.3",
    "rxjs": "^7.8.2",
    "socket.io-client": "^4.8.3",
    "styled-components": "^5.3.11",
    "tailwind-merge": "^3.5.0",
    "tedious": "^18.2.1",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.20",
