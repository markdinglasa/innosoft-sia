    "fast-check": "^4.7.0",
    "file-loader": "^6.2.0",
    "jsdom": "^29.0.1",
    "postcss": "^8.5.8",
    "prettier": "^3.2.4",
    "redux-devtools-extension": "^2.13.9",
    "style-loader": "^3.3.1",
    "tailwindcss": "^4.2.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "url-loader": "^4.1.1",
    "vite": "^7.1.10",
    "vitest": "^4.1.2"
  }
}
