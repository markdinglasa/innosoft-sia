{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/*",
    "src/main/**/*.ts",
    "src/preload/*.ts",
    "src/preload/**/*",
    "src/preload/**/**/*",
    "src/preload/**/**/**/*",
    "src/shared/**/*.ts",
    "src/shared/**/*.tsx",
    "src/shared/**/**/*",
    "src/shared/**/**/**/*",
    "src/shared/**/**/**/**/*",
    "src/shared/**/**/**/**/**/*",
    "src/declaration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/main/*",
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
