{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/main/**/**/*",
    "src/main/**/**/**/*",
    "src/main/**/**/**/**/*",
    "src/main/**/**/**/**/**/*",
    "src/main/**/**/**/**/**/**/*",
    "src/preload/*",
    "src/preload/**/*",
    "src/preload/**/**/*",
    "src/preload/**/**/**/*",
    "src/shared/**/*",
    "src/shared/**/**/*",
    "src/shared/**/**/**/*",
    "src/shared/**/**/**/**/*",
    "src/shared/**/**/**/**/**/*",
    "src/declaration.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "types": [
      "electron-vite/node"
    ],
    "baseUrl": ".",
    "paths": {
      "@main/*": [
        "src/main/*"
      ],
      "@shared/*": [
        "src/shared/*"
      ]
    }
  }
}
